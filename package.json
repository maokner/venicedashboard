{
  "name": "venice-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "esbuild tests/data.test.ts --bundle --platform=node --format=esm --outfile=.cache/venice-tests.mjs && node --test .cache/venice-tests.mjs",
    "format:check": "prettier --check src tests index.html vite.config.ts vercel.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
